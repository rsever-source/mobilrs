{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Engelli.me Kavram Sözlüğü Şeması — sürüm 1.0.3 (2026-11-11). 1.0.2'ye göre kanonik_ad ve alt_bolum uzunluk sınırları gerçek kaynak başlıklarını kayıpsız taşıyacak şekilde genişletilmiştir.",
  "title": "Engelli.me Kavram Sözlüğü Şeması v1.0.2 (taslak)",
  "description": "EK-1 (Maluliyet ve Çalışma Gücü Kaybı Tespiti İşlemleri Yönetmeliği, 28.09.2021/31612) ve EK-2 (Erişkinler İçin Engellilik Değerlendirmesi Hakkında Yönetmelik, 20.02.2019/30692) kavram kayıtları. Her kayıt tek mevzuat bağlantısı taşır; ortak kavram iki ayrı kayıtla modellenir. ICD-10 yalnız EK-2 bağlamında, WHO etiketi ve kaynak kanıtıyla birlikte kullanılabilir.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kavram_id",
    "kanonik_ad",
    "es_anlamli",
    "kaynak"
  ],
  "properties": {
    "kavram_id": {
      "type": "string",
      "pattern": "^(ek1|ek2)_[a-z0-9_]{3,76}$",
      "description": "Benzersiz kimlik. Önek bağlantıyla zorunlu olarak eşleşir: EK-1 kaydı 'ek1_', EK-2 kaydı 'ek2_' ile başlar."
    },
    "kanonik_ad": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500,
      "description": "Resmî metinde geçen terim, basıldığı gibi. Hesaplama kuralı adları (örn. Balthazard) bu alana yazılmaz."
    },
    "ek_1_baglantisi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bolum_harfi",
        "sira_no",
        "derece"
      ],
      "description": "2021 Yönetmeliği EK-1 hastalık listesi bağlantısı. Numaralandırma bölüm içinde yeniden başlar; resmî bir toplam madde sayısı yoktur.",
      "properties": {
        "bolum_harfi": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E",
            "F",
            "G",
            "H",
            "I",
            "İ",
            "J",
            "K",
            "L",
            "M",
            "N",
            "O",
            "P",
            "R"
          ],
          "description": "EK-1 harfli bölümü. R = ORTAK HÜKÜMLER. 'I' ve 'İ' ayrı değerlerdir; otomatik dönüşüm yapılmaz. Basılı harfler Aşama 2-A'da tek tek teyit edilecek."
        },
        "sira_no": {
          "type": "integer",
          "minimum": 1,
          "description": "Bölüm içindeki Arap rakamlı sıra numarası (bölüm başına yeniden başlar)."
        },
        "derece": {
          "type": "string",
          "enum": [
            "agir",
            "orta",
            "hafif",
            "ortak_hukum"
          ],
          "description": "Çalışma gücü kaybı düzeyi. R bölümünde yalnız 'ortak_hukum'."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "bolum_harfi"
            ],
            "properties": {
              "bolum_harfi": {
                "const": "R"
              }
            }
          },
          "then": {
            "properties": {
              "derece": {
                "const": "ortak_hukum"
              },
              "sira_no": {
                "maximum": 3
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "bolum_harfi"
            ],
            "properties": {
              "bolum_harfi": {
                "not": {
                  "const": "R"
                }
              }
            }
          },
          "then": {
            "properties": {
              "derece": {
                "enum": [
                  "agir",
                  "orta",
                  "hafif"
                ]
              }
            }
          }
        }
      ]
    },
    "ek_2_baglantisi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bolum_adi"
      ],
      "description": "2019 Yönetmeliği EK-2 engel oranları alan kılavuzu bağlantısı. Bazı kayıtlar hastalık adı/oran listesi biçimindedir ve ayrı tanım metni içermez; tanim bu nedenle isteğe bağlıdır.",
      "properties": {
        "bolum_adi": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120,
          "description": "Ekte basılı organ sistemi başlığı (örn. 'KULAK BURUN BOĞAZ')."
        },
        "alt_bolum": {
          "type": "string",
          "maxLength": 120,
          "description": "Ekte basıldığı gibi alt bölüm etiketi (örn. 'A-İŞİTME', 'B-KONUŞMA VE SES', 'IV-'). Her bölüm alt bölüm kullanmadığı için isteğe bağlıdır; dönüştürme yapılmaz."
        },
        "madde_etiketi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "description": "Ekte basıldığı gibi madde etiketi: 1, IV, a), 2.1 vb. Kaynakta ayrı bir madde etiketi yoksa alan yazılmaz; yapay etiket üretilmez."
        },
        "tanim": {
          "type": "string",
          "minLength": 5,
          "description": "Ekte ayrı bir tanım/kriter metni varsa basıldığı gibi yazılır. Kaynak yalnız hastalık adını listeliyorsa bu alan yazılmaz; açıklama uydurulmaz."
        },
        "icd10": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "description": "WHO ICD-10 eşlemesi. Yalnız EK-2'de. Her kod kendi WHO etiketi, kaynak URL'si ve erişim tarihiyle gelir.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kod",
              "who_etiketi",
              "kaynak_url",
              "erisim_tarihi",
              "esleme_notu"
            ],
            "properties": {
              "kod": {
                "type": "string",
                "pattern": "^[A-Z][0-9]{2}(\\.[0-9])?$"
              },
              "who_etiketi": {
                "type": "string",
                "minLength": 3,
                "maxLength": 120,
                "description": "WHO ICD-10 tarayıcısında görünen İngilizce etiket, birebir."
              },
              "kaynak_url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "erisim_tarihi": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "esleme_notu": {
                "type": "string",
                "maxLength": 300,
                "description": "Bu ICD-10 kodunun bu EK-2 kavramına neden bağlandığına ilişkin kaynak temelli gerekçe. WHO etiketi yerine geçmez; gerekçe yoksa kod eklenmez.",
                "minLength": 10
              }
            }
          }
        }
      }
    },
    "es_anlamli": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "description": "Eş anlamlı / halk dili karşılıkları. Boş dizi geçerlidir; kayıt yine de bu alanı taşımak zorundadır.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dil",
          "termin"
        ],
        "properties": {
          "dil": {
            "type": "string",
            "enum": [
              "tr",
              "en",
              "ku",
              "az",
              "kk",
              "ba"
            ]
          },
          "termin": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "kaynak": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "kaynak_turu": {
            "type": "string",
            "enum": [
              "mevzuat_metni",
              "ek_1_ekrani",
              "ek_2_ekrani",
              "site_verisi",
              "kullanici_tanimi"
            ]
          }
        }
      }
    },
    "derleme_referansi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kaynak",
        "kayit_no"
      ],
      "description": "Üçüncü taraf derleme indeksi. Resmî mevzuat numarası DEĞİLDİR; yalnız izlenebilirlik içindir.",
      "properties": {
        "kaynak": {
          "type": "string",
          "enum": [
            "engelliler_biz_derlemesi",
            "engelli_me_katalogu"
          ]
        },
        "kayit_no": {
          "type": "integer",
          "minimum": 1
        },
        "derleme_toplami": {
          "type": "integer",
          "minimum": 1,
          "description": "Derleme kaynağının bildirdiği toplam. Bağımsız doğrulanmamıştır; resmî sayı olarak kullanılamaz."
        },
        "not": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "kaynak": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "belge_adi",
        "rg_tarihi",
        "rg_sayisi",
        "url",
        "erisim_tarihi",
        "sayfa_no"
      ],
      "properties": {
        "belge_adi": {
          "type": "string",
          "minLength": 5,
          "maxLength": 200
        },
        "rg_tarihi": {
          "type": "string",
          "pattern": "^\\d{2}\\.\\d{2}\\.\\d{4}$",
          "description": "Resmî Gazete tarihi (gg.aa.yyyy)."
        },
        "rg_sayisi": {
          "type": "integer",
          "minimum": 1,
          "description": "Resmî Gazete sayısı (EK-1: 31612, EK-2: 30692). Zorunludur."
        },
        "mbs_no": {
          "type": "integer",
          "minimum": 1,
          "description": "Mevzuat Bilgi Sistemi numarası (EK-2: 31275). Resmî Gazete sayısı değildir; ayrı tutulur."
        },
        "yonetmelik_maddesi": {
          "type": "string",
          "pattern": "^[0-9]{1,2}(/[0-9]{1,2})?(\\([a-zçğıöşü]\\))?$",
          "description": "Hükmün dayandığı yönetmelik maddesi (örn. '4/1(g)', '5/4')."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "sayfa_no": {
          "type": "integer",
          "minimum": 1,
          "description": "Kavramın geçtiği resmî PDF/ek sayfası. Her kayıt için zorunludur."
        },
        "erisim_tarihi": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "olusturulma_tarihi": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 tarih-saat (örn. '2026-11-11T00:00:00Z'). FormatChecker ile denetlenir."
    }
  },
  "oneOf": [
    {
      "required": [
        "ek_1_baglantisi"
      ],
      "not": {
        "required": [
          "ek_2_baglantisi"
        ]
      },
      "properties": {
        "kavram_id": {
          "pattern": "^ek1_"
        },
        "kaynak": {
          "properties": {
            "rg_sayisi": {
              "const": 31612
            },
            "rg_tarihi": {
              "const": "28.09.2021"
            }
          }
        }
      }
    },
    {
      "required": [
        "ek_2_baglantisi"
      ],
      "not": {
        "required": [
          "ek_1_baglantisi"
        ]
      },
      "properties": {
        "kavram_id": {
          "pattern": "^ek2_"
        },
        "kaynak": {
          "properties": {
            "rg_sayisi": {
              "const": 30692
            },
            "rg_tarihi": {
              "const": "20.02.2019"
            },
            "mbs_no": {
              "const": 31275
            }
          }
        }
      }
    }
  ]
}